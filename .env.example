# ============================================================
# 环境变量模板：本文件会被提交到 git，只列变量名、不填真实值。
# 使用方法：复制为 .env，再填入各自的真实密钥/凭据。
#   Windows(PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ============================================================

# 模型密钥
OPEN_CHAT_API_KEY=OPEN_CHAT_API_KEY
OPEN_EMBEDDING_API_KEY=OPEN_EMBEDDING_API_KEY

# QQ 官方机器人凭据
QQ_BOT_APPID=QQ_BOT_APPID
QQ_BOT_SECRET=QQ_BOT_SECRET

# 通道地址（一般不用改；沙箱或代理时取消注释覆盖）
# QQ_API_BASE=https://api.bot.qq.com
# QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken

# 精排模型目录（bge-reranker-v2-m3 的权重目录，本地自备、不进 git；留空则跳过精排）
RERANKER_MODEL_DIR=RERANKER_MODEL_DIR
