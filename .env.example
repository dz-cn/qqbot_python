# ============================================================
# 环境变量模板：本文件会被提交到 git，只列变量名、不填真实值。
# 使用方法：复制为 .env，再填入各自的真实密钥/凭据。
#   Windows(PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ============================================================

# DeepSeek 模型密钥（以 sk- 开头）
DEEPSEEK_API_KEY=

# QQ 官方机器人凭据
QQ_BOT_APPID=
QQ_BOT_SECRET=
